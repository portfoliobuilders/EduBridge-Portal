# Supabase Project URL (e.g. https://your-project-ref.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase Publishable / Anon API key (safe for browser client-side usage)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase Service Role Secret Key (SERVER-SIDE ONLY - never expose to browser)
SUPABASE_SECRET_KEY=

# Resend API Key for sending transactional receipt & statement emails (re_...)
RESEND_API_KEY=

# Verified sender email address formatted as "Name <email@domain.com>"
EMAIL_FROM=

# Public canonical URL of the deployed application (e.g. https://billing.edubridgeeducation.com)
NEXT_PUBLIC_APP_URL=
